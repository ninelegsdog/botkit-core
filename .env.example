# botkit-core — пример переменных окружения.
# В библиотеке читаются только эти две переменные, и обе опциональны.
# Секреты (токен бота, ключи ЮKassa, DSN Sentry) передаёт вызывающий бот —
# здесь их быть не должно.

# Коммит, который собран в образ. Публикуется в /health и /version,
# чтобы работающий контейнер можно было сопоставить с коммитом.
BUILD_SHA=

# Endpoint OTLP-коллектора для botkit_core.tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=